LOCAL_TEST_DATA/

# python bytecode
__pycache__/
*.py[cod]
*$py.class

# distribution anc packaging
build/
dist/
*.egg-info/
*.egg
*.whl

# virtual environments
venv/
.env/
.envrc
.venv/

# OS and editor junk
.DS_Store
.vscode/
.cursorignore
*.swp
*.swo

# pytest / testing / coverage
htmlcov/
.coverage
.tox/
.pytest_cache/
.cache/
nosetests.xml
coverage.xml
*.log

# misc
*.out
*.tmp

# Benchmark artifacts: synthetic datasets and the local results log
# (benchmark_log.tsv contains machine-specific paths, so it is generated
# per machine rather than tracked). benchmark_hr_log.tsv is the same log
# with byte columns scaled for reading.
benchmarks/data/
benchmarks/benchmark_log.tsv
benchmarks/benchmark_hr_log.tsv

# Local sequencing-read datasets; real read data is far too large to track
# and test fixtures live under tests/ instead
*reads*.tsv
*reads*.fasta
*reads*.fastq
